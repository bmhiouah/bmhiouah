; Engine configuration file.
; Tension — PC-first social deduction prototype (Killer Within–inspired loop).
config_version=5

[application]
config/name="Tension"
config/description="Local two-player social deduction: Investigate → Deduce → Eliminate. Skill and observation over luck."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.2", "4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
GameState="*res://scripts/core/game_state.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.1, 1)
